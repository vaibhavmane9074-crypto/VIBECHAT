# ─── VIBECHAT server configuration (copy to server/.env and edit) ───

# Core
PORT=4811
HOST=0.0.0.0                 # bind all interfaces in production
NODE_ENV=development          # production turns on Secure cookies + 1h static cache

# Storage
VC_DB_PATH=data/vibechat.db   # SQLite file (WAL). Back this up + the uploads dir.
VC_UPLOADS_DIR=data/uploads
VC_MAX_UPLOAD_MB=100          # per-file cap (server also enforces magic-byte validation)

# Sessions / cookies
VC_SESSION_SECRET=change-me-to-a-long-random-string
VC_COOKIE_SECURE=auto         # auto = Secure when NODE_ENV=production / HTTPS detected

# Admin bootstrap (recommended for deployments)
VC_ADMIN_EMAIL=admin@example.com
VC_ADMIN_PASSWORD='replace-with-a-long-random-passphrase'
VC_ADMIN_USERNAME=vibeadmin   # optional (defaults to vibeadmin_<emaillocalpart>)
VC_ADMIN_DISPLAYNAME='Vibe Admin'

# Rate limits (per IP, per minute)
VC_RATE_API=300
VC_RATE_AUTH=20
VC_RATE_UPLOAD=30

# AI (keys NEVER go to the client; first present wins)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-1.5-flash

# Real email delivery (optional; dev prints codes to the console instead)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="VIBECHAT <no-reply@example.com>"

# Calls: NAT-traversal. Without TURN, calls on strict mobile/corporate networks will not connect.
# Run a TURN server (e.g. coturn) and set all three values, then restart the server.
# Verify: GET /api/calls/ice-servers (logged in) should list your turn: URL.
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=chat
# TURN_PASS=secret

# CORS (comma-separated origins; leave empty for same-origin only)
# VC_CORS=https://chat.example.com
